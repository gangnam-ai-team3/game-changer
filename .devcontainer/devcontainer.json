{
  "$schema": "https://raw.githubusercontent.com/devcontainers/spec/main/schemas/devContainer.base.schema.json",
  "name": "Game Changer Demo",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "24"
    }
  },
  "postCreateCommand": "python -m pip install --user uv==0.11.26 && \"$(python -m site --user-base)/bin/uv\" sync --extra dev --locked && npm --prefix frontend ci",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "Game Changer Demo",
      "onAutoForward": "notify",
      "protocol": "http"
    },
    "8000": {
      "label": "FastAPI (internal)",
      "onAutoForward": "ignore"
    }
  },
  "otherPortsAttributes": {
    "onAutoForward": "ignore"
  },
  "secrets": {
    "ANTHROPIC_API_KEY": {
      "description": "공개 시연에서 Claude 멀티에이전트를 실행할 Anthropic API 키"
    }
  }
}
