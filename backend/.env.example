# Copy this file to backend/.env and fill it locally. Never commit backend/.env.
ANTHROPIC_API_KEY=
# Claude is used only when the request explicitly sets use_llm=true.
LLM_PROVIDER=claude
CLAUDE_MAX_USD=5
CLAUDE_MAX_REQUESTS=3
CLAUDE_MAX_OUTPUT_TOKENS=3000
CLAUDE_MAX_INPUT_CHARS=50000
# Evidence synthesis needs the stronger reasoning model; the two narrative-only stages use Haiku.
CLAUDE_RAG_MODEL=claude-sonnet-4-6
CLAUDE_REDTEAM_MODEL=claude-haiku-4-5
CLAUDE_AUDIT_MODEL=claude-haiku-4-5
# Update review uses Korean narrative-only Claude calls with the same shared budget.
CLAUDE_UPDATE_EVIDENCE_MODEL=claude-sonnet-4-6
CLAUDE_UPDATE_REDTEAM_MODEL=claude-haiku-4-5
CLAUDE_UPDATE_AUDIT_MODEL=claude-haiku-4-5
CLAUDE_UPDATE_COLLECTOR_MODEL=claude-haiku-4-5
X_BEARER_TOKEN=
